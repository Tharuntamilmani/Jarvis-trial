# JARVIS configuration template.
# Copy to .env and adjust. NEVER put production secrets here —
# API keys belong in the DPAPI credential store (security/credentials.py).

JARVIS_ENVIRONMENT=development
JARVIS_LOG_LEVEL=INFO

# PostgreSQL (development default, matches database/docker-compose.yml)
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5432/jarvis

# Embedding dimension — fixed per database, changed only via explicit migrations.
JARVIS_EMBEDDING_DIM=1024

# AI providers (clients arrive in Phase 2; endpoints recorded now)
JARVIS_OLLAMA_HOST=http://localhost:11434
JARVIS_OLLAMA_MODEL=qwen3:8b
JARVIS_OLLAMA_KEEP_ALIVE=10m
# Disable the reasoning channel for thinking models (qwen3). Set true to
# stream reasoning (it consumes the token budget before answer text).
JARVIS_OLLAMA_THINK=false
# Cloud AI — Groq is the OPTIONAL consent-gated fallback (Stage 2.4 adds
# consent + routing). The API key NEVER lives here or in .env: store it in
# the DPAPI credential store via `python scripts/import_groq_key.py`.
JARVIS_GROQ_MODEL=llama-3.3-70b-versatile
JARVIS_GROQ_API_BASE=https://api.groq.com/openai/v1
